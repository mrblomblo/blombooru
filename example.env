# Docker Tag
BLOMBOORU_TAG=latest # set to `pre` for the latest pre-release, `latest` for the latest stable release, or a version tag (e.g. `1.2.3`)

# Application Settings
APP_NAME=Blombooru
APP_PORT=8000

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=blombooru
POSTGRES_HOST=db
POSTGRES_PORT=5432 # used for the Host port mapping in Docker, does not affect the internal application port.

# Redis Settings
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379 # used for the Host port mapping in Docker, does not affect the internal application port.
REDIS_DB=0
REDIS_PASSWORD=supersecretpasswordbutredis

# Shared Tag Database Settings
SHARED_TAGS_ENABLED=false
SHARED_TAG_DB_USER=postgres
SHARED_TAG_DB_PASSWORD=supersecretsharedtagdbpassword
SHARED_TAG_DB=shared_tags
SHARED_TAG_DB_HOST=shared-tag-db
SHARED_TAG_DB_PORT=5431 # used for the Host port mapping in Docker, does not affect the internal application port.

# AI Tag Predictor Settings
BLOMBOORU_WD_TAGGER_DEVICE=auto # cpu, cuda, auto
BLOMBOORU_WD_TAGGER_IDLE_TIMEOUT=60 # time in seconds until unloading model from memory. Setting to `0` will keep it loaded indefinitely

# Proxy Settings
# Trusted reverse-proxy IPs/CIDRs (comma-separated). Leave empty for direct-access deployments;
# the X-Forwarded-For header is then ignored and the TCP peer is used for rate-limiting instead.
# Example (nginx on the same Docker network): BLOMBOORU_TRUSTED_PROXIES=172.16.0.0/12,::1
# Use the narrowest CIDR that covers your proxy. Do not set uvicorn's FORWARDED_ALLOW_IPS=* alongside this.
BLOMBOORU_TRUSTED_PROXIES=
